# AETHERIS Environment Variables Template
# Copy this file to .env and modify the values as needed

# Ports Configuration
# Backend API server port (internal: 8080, external: configurable)
AETHERIS_BACKEND_PORT=8080
NOFX_BACKEND_PORT=8080

# Frontend web interface port (Nginx listens on port 80 internally)
AETHERIS_FRONTEND_PORT=3434
NOFX_FRONTEND_PORT=3434

# Timezone Setting
# System timezone for container time synchronization
AETHERIS_TIMEZONE=Asia/Shanghai
NOFX_TIMEZONE=Asia/Shanghai

# Admin password when admin_mode=true
AETHERIS_ADMIN_PASSWORD=admin123
NOFX_ADMIN_PASSWORD=admin123

# Optional AI keys (preferred over SQLite). docker-compose passes these through.
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
