# AETHERIS Environment Variables Template
# Copy this file to .env and modify the values as needed

# Ports Configuration
# Backend API server port (internal: 3636, external: configurable)
AETHERIS_BACKEND_PORT=3636
NOFX_BACKEND_PORT=3636

# Frontend web interface port (Nginx listens on port 80 internally)
AETHERIS_FRONTEND_PORT=3000
NOFX_FRONTEND_PORT=3000

# Timezone Setting
# System timezone for container time synchronization
AETHERIS_TIMEZONE=Asia/Shanghai
NOFX_TIMEZONE=Asia/Shanghai

# Admin password when admin_mode=true (REQUIRED - use a strong password!)
AETHERIS_ADMIN_PASSWORD=
NOFX_ADMIN_PASSWORD=

# JWT Secret for authentication (REQUIRED - generate with: openssl rand -base64 64)
AETHERIS_JWT_SECRET=
NOFX_JWT_SECRET=
